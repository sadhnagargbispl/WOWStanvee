                            <a href="freeProduct.aspx">Free Product</a>
                            <a href="MovieBookingRedirect.aspx">Movies</a>
                        </div>
                    </div>


                    <% if (Session["Status"] != null && Session["Status"].ToString() == "OK")
                        { %>


                    <div class="dropdown">
                        <a href="#" class="dropbtn">
                            <asp:Label ID="LblName" runat="server" Text=""></asp:Label>(<asp:Label ID="LblIDno" runat="server" Text=""></asp:Label>)<i class="fas fa-caret-down"></i></a>
                        <div class="dropdown-content">
                            <a href="ReferLink.aspx">Refer Link</a>
                            <a href="logout.aspx">Logout</a>
                        </div>
                    </div>

                    <% }
