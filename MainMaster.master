                        <div class="dropdown-content">
                            <a href="https://shop.stanvee.com/">Shop</a>
                            <a href="BrandStoreRedirect.aspx">Brand Store</a>
                        </div>
                    </div>

                    <div class="dropdown">
                        <a href="#" class="dropbtn">Our Services<i class="fas fa-caret-down"></i></a>
                        <div class="dropdown-content">
